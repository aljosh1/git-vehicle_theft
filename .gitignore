# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# =============================================================================
#  Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Testing / coverage / type checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# =============================================================================
#  Runtime data - DB, uploaded videos, captured evidence, face images
# =============================================================================
data/
!data/.gitkeep

# Application logs
logs/
*.log
*.log.*

# =============================================================================
#  Model weights - far too large for Git
# =============================================================================
# Trained weights are large, so they are excluded by default. The three files the
# deployed API actually needs are re-included below, because otherwise the Docker
# image ships without them and detection silently falls back to weaker paths:
#   *             -> classical OpenCV plate localisation
#   *    -> no face detection at all
#   * models/face_recognition_sface.onnx  -> coarse histogram descriptor instead of
#                                            128-d SFace embeddings
# yolov8n.pt is deliberately still ignored; Ultralytics downloads it on first use.
models/license_plate.pt 
models/face_detection_yunet.onnx 
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.tflite
models/*.bin
models/backups/
models/install_receipts/
!models/README.md
!models/license_plate.pt
!models/face_detection_yunet.onnx
!models/face_recognition_sface.onnx

# =============================================================================
#  Datasets & training artefacts
# =============================================================================
runs/
training/outputs/
dataset/raw/
dataset/annotations/
dataset/images/
dataset/labels/
dataset/sources/
*.zip
*.tar.gz
!documentation/*.zip

# =============================================================================
#  Node / frontend
# =============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-error.log*
.vite/

# =============================================================================
