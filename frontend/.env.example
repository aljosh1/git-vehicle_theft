# =============================================================================
#  Frontend build-time configuration (Vite).
#
#  Only variables prefixed with VITE_ are exposed to the browser bundle.
#  Never put a real secret here - everything in this file ends up in JavaScript
#  that any visitor can read in DevTools.
#
#  Copy to `.env.local` (git-ignored) for local work, or set the variables in
#  Vercel under Settings -> Environment Variables.
# =============================================================================

# Local development: leave this EMPTY.
# `vite.config.js` proxies /api and /media to http://127.0.0.1:8000, so the
# browser only ever sees one origin and CORS never comes into play.
#
# On Vercel (or any static host) there is no dev-server proxy, so point this at
# the public origin of the deployed backend, with NO trailing slash:
#
#   VITE_API_BASE_URL=https://api.example.com
#
# Your backend must be reachable over plain HTTPS from the internet. If it is
# running on your own machine you need a tunnel (ngrok / cloudflared / localtunnel)
# and must use the tunnel URL, not localhost.
#
# Alternative: leave this empty and set the rewrites in vercel.json instead, so
# requests stay same-origin and CORS is bypassed entirely. Pick ONE approach -
# setting both is harmless but the base URL takes precedence.
VITE_API_BASE_URL=
