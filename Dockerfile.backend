# Build stage - Python backend
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for OpenCV, image processing, and models
RUN apt-get update && apt-get install -y \
    libsm6 libxext6 libxrender-dev \
    libgomp1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire application
COPY backend/ ./backend/
# Weights are git-ignored, so only models/README.md is normally present here.
# The plate detector falls back to classical OpenCV localisation, and the
# vehicle detector auto-downloads yolov8n.pt on first use.
COPY models/ ./models/
COPY conftest.py .
# .env.example documents every supported setting for platforms that inject
# configuration from their own dashboard (Render, Railway, Fly, ...).
COPY .env.example ./.env.example

# Create data directories
RUN mkdir -p data/uploads data/evidence data/faces data/vehicles logs

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=5)"

# Run backend.
#
# Render (and most PaaS providers) route traffic to $PORT and inject it at build
# time, so honour the variable and fall back to 8000 for local runs. Using the
# shell form is required here precisely because of the expansion.
# One worker only: the detection pipeline holds in-process camera state and
# uploaded evidence on local disk, so multiple workers would drift apart.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
