# =============================================================================
#  Copy this file to `.env` and fill in your own values.
#  Never commit the real `.env` - it holds live credentials.
# =============================================================================

# ---- Core -------------------------------------------------------------------
APP_NAME="Vehicle Theft Detection System"
DEBUG=true
# CHANGE THIS. Used to sign JWT access tokens.
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Database ---------------------------------------------------------------
DATABASE_URL="sqlite:///./data/vtds.db"

# ---- First admin account (created by `python -m backend.database.seed`) -----
# Note: must be a syntactically valid public email. Reserved TLDs such as
# ".local" are rejected by the email validator.
ADMIN_EMAIL="admin@vtds.example.com"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="System Administrator"

# ---- Model weights ----------------------------------------------------------
# Vehicle + person detection (COCO pretrained is fine to start).
VEHICLE_MODEL_PATH="models/yolov8n.pt"
# Optional: a YOLOv8 model fine-tuned on license plates. If the file is
# missing the system falls back to classical OpenCV plate localisation.
PLATE_MODEL_PATH="models/license_plate.pt"
PLATE_DETECTOR_BACKEND="auto"   # auto | yolo | roboflow | opencv
ROBOFLOW_API_URL="https://serverless.roboflow.com"
ROBOFLOW_MODEL_ID="vehicle-license-plate-1hdcy/1"
ROBOFLOW_API_KEY=""             # set locally; never commit real key
DEVICE="cpu"                      # "cpu", "cuda", or "cuda:0"

# ---- Detection thresholds ---------------------------------------------------
VEHICLE_CONF_THRESHOLD=0.45
PERSON_CONF_THRESHOLD=0.45
PLATE_CONF_THRESHOLD=0.35
FACE_MATCH_THRESHOLD=0.65         # cosine similarity; higher = stricter
PLATE_FUZZY_THRESHOLD=0.80        # OCR tolerance when matching plates

# ---- Real-time performance --------------------------------------------------
TARGET_FPS=30
FRAME_WIDTH=1280
FRAME_HEIGHT=720
VIDEO_FILE_FRAME_STRIDE=5         # uploaded/local videos: analyse 1 in every N frames
DETECT_EVERY_N_FRAMES=1           # reserved for live detector striding
FACE_EVERY_N_FRAMES=5             # face recognition is the slowest stage
OCR_EVERY_N_FRAMES=5

# ---- Theft logic ------------------------------------------------------------
THREAT_ALERT_THRESHOLD=60         # score >= this dispatches an alert
ALERT_COOLDOWN_SECONDS=120        # per-camera anti-spam window
PROXIMITY_IOU_THRESHOLD=0.02      # person/vehicle overlap = "near vehicle"

# ---- Site / GPS location (embedded in alerts) -------------------------------
SITE_NAME="Main Gate - Car Park A"
SITE_LATITUDE=6.5244
SITE_LONGITUDE=3.3792

# ---- Email alerts (SMTP) ----------------------------------------------------
ALERTS_EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-16-char-google-app-password"
SMTP_USE_TLS=true
ALERT_EMAIL_FROM="you@gmail.com"
# Comma-separated fallback recipients (security desk).
ALERT_EMAIL_TO="security@example.com"

# ---- SMS alerts (Twilio) ----------------------------------------------------
ALERTS_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+15005550006"
ALERT_SMS_TO="+2348000000000"

# ---- Frontend ---------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
